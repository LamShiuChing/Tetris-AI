<Controls:MetroWindow x:Class="Zetris.PPT.UI"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
                      xmlns:Zetris="clr-namespace:Zetris.PPT"
                      Style="{StaticResource ZetrisWindow}"
                      Title="Titan for PPT2" WindowStartupLocation="CenterScreen" Width="230">

    <StackPanel Margin="15 10">
        <StackPanel HorizontalAlignment="Center">
            <TextBlock Margin="5 0 5 1" Foreground="#B9B0E6" x:Name="State" />

            <Border BorderBrush="#2A1F55" Height="1" BorderThickness="0 0 0 1" />
        </StackPanel>

        <Grid MinHeight="15">
            <StackPanel x:Name="Info">
                <TextBlock Margin="0 5 0 0" Foreground="#FFD93D" TextWrapping="Wrap" x:Name="Plan" />

                <TextBlock Margin="0 5" x:Name="Confidence" />

                <TextBlock Margin="0 0 0 5" x:Name="ThinkingTime" />

                <Border Margin="0 0 0 5" BorderBrush="#2A1F55" Height="1" BorderThickness="0 0 0 1" />
            </StackPanel>
        </Grid>

        <Grid Margin="0 0 0 5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Margin="0 0 5 0" VerticalAlignment="Center" Text="Bot:" />

            <ComboBox Grid.Column="1" x:Name="Personality" SelectionChanged="PersonalityChanged" />
        </Grid>

        <TextBlock Margin="0 0 0 5" Foreground="#B9B0E6" FontSize="11" TextWrapping="Wrap" x:Name="PersonalityInfo" />

        <Zetris:Dial Margin="0 0 0 5" Scale="0.5" Minimum="1" Maximum="10" Default="10" Title="Strength:" AllowPrecise="False" x:Name="Strength" Changed="StrengthChanged" />

        <Zetris:Dial Margin="0 0 0 5" Scale="0.5" Minimum="10" Maximum="100" Unit="%" Title="Speed:" AllowPrecise="False" x:Name="Speed" Changed="SpeedChanged" />

        <CheckBox Margin="0 0 0 5" Content="Hold Allowed" x:Name="HoldAllowed" Click="HoldAllowedChanged" />

        <Border Margin="0 0 0 5" BorderBrush="#2A1F55" Height="1" BorderThickness="0 0 0 1" />

        <Zetris:Dial Margin="0 0 0 5" Scale="0.5" FillStart="False" Default="2" Minimum="1" Maximum="4" Unit="P" Title="Versus Player:" AllowPrecise="False" x:Name="Player" Changed="PlayerChanged" />

        <CheckBox Margin="0 0 0 5" IsChecked="True" Content="Gamepad Connected" x:Name="Gamepad" Click="GamepadChanged" />

        <CheckBox Margin="0 0 0 5" Content="Accurate Game Sync" x:Name="AccurateSync" Click="AccurateSyncChanged"
                  ToolTip="Scan for every game frame to avoid skipped frames, at the cost of CPU.&#x0a;Uncheck only if your PC struggles." />

        <Border Margin="0 0 0 5" BorderBrush="#2A1F55" Height="1" BorderThickness="0 0 0 1" />

        <Zetris:GamepadPanel Margin="0 0 0 5" x:Name="GamepadPanel" />

        <Border Margin="0 0 0 5" BorderBrush="#2A1F55" Height="1" BorderThickness="0 0 0 1" />

        <StackPanel HorizontalAlignment="Center">
            <TextBlock Margin="5 0 5 1" Foreground="#B9B0E6" x:Name="Version" />

            <Border BorderBrush="#2A1F55" Height="1" BorderThickness="0 0 0 1" />
        </StackPanel>
    </StackPanel>
</Controls:MetroWindow>
